# Copy this file to .env.staging, then fill staging-only values.
# Database, Auth, session, and API credentials must remain staging-only.
# File storage may use the shared storage service, but every staging object is isolated under staging/.

VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
VITE_APP_PUBLIC_URL=https://sigap.marison-testing.biz.id

STAGING_APP_PORT=3011
APP_PUBLIC_URL=https://sigap.marison-testing.biz.id
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SESSION_SECRET=replace-with-a-unique-32-character-minimum-secret

STORAGE_MODE=self_hosted_supabase
STORAGE_SUPABASE_URL=https://your-shared-storage-domain
STORAGE_SUPABASE_SERVICE_ROLE_KEY=replace-with-shared-storage-service-role-key
STORAGE_PUBLIC_BASE_URL=https://your-shared-storage-domain/storage/v1/object/public
STORAGE_PATH_PREFIX=staging

PDF_WORKER_CONCURRENCY=1

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-staging-smtp-password
SMTP_FROM=noreply@example.com

WEB_PUSH_PUBLIC_KEY=replace-with-staging-web-push-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-staging-web-push-private-key
WEB_PUSH_SUBJECT=mailto:noreply@example.com

MARISON_DEPLOYMENT_ENVIRONMENT=staging
MARISON_SUBMISSION_DISPATCH_ENABLED=true
MARISON_OUTBOUND_INTERNAL_TOKEN=replace-with-a-unique-32-character-minimum-secret
MARISON_OUTBOUND_TIMEOUT_MS=30000
STAGING_DEFAULT_USER_PASSWORD=replace-with-staging-only-default-password
MARISON_STAGING_BASE_URL=https://marison-external.digivasi.com/api
MARISON_STAGING_CLIENT_ID=replace-with-staging-client-id
MARISON_STAGING_CLIENT_SECRET=replace-with-staging-client-secret
MARISON_STAGING_OUTBOUND_NIK_OVERRIDE=A 114
MARISON_SYNC_ENABLED=true
MARISON_SYNC_CRON_TOKEN=replace-with-a-unique-32-character-minimum-secret
MARISON_PRODUCTION_BASE_URL=https://external.marisonregency.id/api
MARISON_PRODUCTION_CLIENT_ID=replace-with-production-client-id
MARISON_PRODUCTION_CLIENT_SECRET=replace-with-production-client-secret
