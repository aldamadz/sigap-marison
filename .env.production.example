# Copy this file to .env.production, then fill real production values.
# Do not commit .env.production.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
VITE_APP_PUBLIC_URL=https://sigap.example.com

APP_PORT=3010
APP_PUBLIC_URL=https://sigap.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Generate once with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

STORAGE_MODE=self_hosted_supabase
STORAGE_SUPABASE_URL=https://your-storage-domain
STORAGE_SUPABASE_SERVICE_ROLE_KEY=replace-with-storage-service-role-key
STORAGE_PUBLIC_BASE_URL=https://your-storage-domain/storage/v1/object/public

PDF_WORKER_CONCURRENCY=2

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=noreply@example.com

WEB_PUSH_PUBLIC_KEY=replace-with-web-push-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-web-push-private-key
WEB_PUSH_SUBJECT=mailto:noreply@example.com

MARISON_EXTERNAL_CLIENT_ID=replace-with-client-id
MARISON_EXTERNAL_CLIENT_SECRET=replace-with-client-secret
MARISON_EXTERNAL_SIGNING_SECRET=replace-with-signing-secret
