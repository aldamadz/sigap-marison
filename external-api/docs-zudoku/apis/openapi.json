{
  "openapi": "3.1.0",
  "info": {
    "title": "SIGAP External API Docs",
    "version": "1.0.0",
    "description": "Dokumentasi resmi untuk integrasi sistem departemen dengan SIGAP.\n\nGunakan tombol **Authorize** untuk memasukkan token akses, lalu coba kirim permintaan langsung dari dokumentasi ini.\n\n### Header wajib\n- `Authorization: Bearer <token>` — masukkan token akses pada dialog Authorize.\n- `Content-Type: application/json` — ditambahkan otomatis saat permintaan dijalankan dari dokumentasi."
  },
  "servers": [
    {
      "url": "https://external.marison-testing.biz.id",
      "description": "SIGAP External API staging"
    }
  ],
  "tags": [
    {
      "name": "Submission Decisions",
      "description": "Keputusan pengajuan dari sistem departemen."
    },
    {
      "name": "System",
      "description": "Endpoint pemantauan sistem."
    }
  ],
  "components": {
    "securitySchemes": {
      "submissionDecisionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Token akses khusus untuk mengirim keputusan pengajuan. Masukkan token saja; dokumentasi otomatis mengirim header `Authorization: Bearer <token>`."
      }
    }
  },
  "paths": {
    "/api/v1/submission-decisions": {
      "post": {
        "operationId": "applySubmissionDecision",
        "summary": "Kirim keputusan pengajuan",
        "description": "Kirim keputusan untuk sebuah pengajuan. Gunakan `rejected` untuk menolak secara terminal atau `revision_required` untuk mengembalikan pengajuan kepada pemohon.\n\n`event_id` adalah kunci idempotensi: permintaan ulang dengan data yang sama akan berhasil, sedangkan data berbeda dengan event yang sama ditolak HTTP 409.\n\nRequest hanya menerima lima field yang tercantum pada schema.\n\n### Header wajib\n`Authorization: Bearer <token>` dan `Content-Type: application/json`. Gunakan tombol **Authorize** dan masukkan token tanpa menulis kata `Bearer`.",
        "tags": [
          "Submission Decisions"
        ],
        "security": [
          {
            "submissionDecisionBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "document_number",
                  "decision",
                  "reason",
                  "decided_at"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Kunci idempotensi. Gunakan UUID baru untuk setiap keputusan bisnis.",
                    "example": "b03a2bcd-83ea-4ff8-8bb9-02829192ed85"
                  },
                  "document_number": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[0-9A-Za-z./_-]+$",
                    "example": "041/UAI/MKT.1/VIII/2026"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "rejected",
                      "revision_required"
                    ],
                    "example": "revision_required"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 1000,
                    "example": "Jumlah barang perlu disesuaikan."
                  },
                  "decided_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp ISO 8601/RFC3339 yang menyertakan zona waktu.",
                    "example": "2026-08-18T14:00:00+07:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Keputusan diterapkan atau replay idempotent berhasil."
          },
          "400": {
            "description": "Payload tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer token tidak valid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nomor dokumen tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Konflik event idempotensi atau state dokumen.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Dokumen belum memenuhi prasyarat keputusan.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Backend SIGAP tidak dapat dihubungi.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "summary": "Cek status layanan",
        "description": "Memeriksa apakah layanan External API aktif dan siap menerima permintaan.",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Layanan aktif.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
