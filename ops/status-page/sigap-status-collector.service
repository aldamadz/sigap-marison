[Unit]
Description=Read-only SIGAP status observations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
TimeoutStartSec=55
ExecStart=/usr/bin/python3 -I /opt/sigap-status/collector.py --publish --config /opt/sigap-status/config.json
