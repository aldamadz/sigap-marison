# Frontend public env
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
VITE_APP_PUBLIC_URL=http://localhost:8080

# App server
APP_PORT=3010
APP_PUBLIC_URL=http://localhost:8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Generate once with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Storage
STORAGE_MODE=self_hosted_supabase
STORAGE_SUPABASE_URL=https://your-storage-domain
STORAGE_SUPABASE_SERVICE_ROLE_KEY=replace-with-storage-service-role-key
STORAGE_PUBLIC_BASE_URL=https://your-storage-domain/storage/v1/object/public

# PDF worker
PDF_WORKER_CONCURRENCY=2

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=noreply@example.com

# Web Push
WEB_PUSH_PUBLIC_KEY=replace-with-web-push-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-web-push-private-key
WEB_PUSH_SUBJECT=mailto:noreply@example.com

# External API client integration
MARISON_EXTERNAL_BASE_URL=https://marison-external.digivasi.com/api
MARISON_EXTERNAL_CLIENT_ID=replace-with-local-client-id
MARISON_EXTERNAL_CLIENT_SECRET=replace-with-client-secret
MARISON_DEFAULT_ENVIRONMENT=staging
MARISON_ENV_SWITCH_ADMIN_EMAILS=admin@example.com
MARISON_STAGING_BASE_URL=https://marison-external.digivasi.com/api
MARISON_STAGING_CLIENT_ID=replace-with-staging-client-id
MARISON_STAGING_CLIENT_SECRET=replace-with-staging-client-secret
MARISON_PRODUCTION_BASE_URL=https://external.marisonregency.id/api
MARISON_PRODUCTION_CLIENT_ID=replace-with-production-client-id
MARISON_PRODUCTION_CLIENT_SECRET=replace-with-production-client-secret
