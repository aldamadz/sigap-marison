    classDef danger fill:#fff0f0,stroke:#dc3545,color:#4a1116,stroke-width:2px;
    classDef complete fill:#dff7e8,stroke:#138a48,color:#0d4828,stroke-width:3px;
    class START,PROFILE,CENTRAL,BRANCH,FORM,FILES,SUMMARY,REGISTER,REC_TASK,IT_LOCK,REC_ITEM,REC_IMAGE,REC_REASON,IT_SIGN,PO_SIGN,ATTACH,C1,C2,C3,C4,C5,B1,B2,B3,B4,B5,NEXT,RETURN,APPLICANT,IT_REVISE,RESTART,SEND action;
    class OFFICE,VALID,RECOMMEND,REC_RULE,ROUTE,DECISION,TARGET,APPLICANT_DECISION decision;
    class REJECT,VOID danger;
